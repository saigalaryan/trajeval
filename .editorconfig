root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Matches ruff's line-length = 100 (packages/trajeval/pyproject.toml)
[*.py]
indent_size = 4
max_line_length = 100

# Matches prettier/eslint defaults used by apps/web
[*.{ts,tsx,js,jsx,json,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false # trailing double-space = markdown line break

[Makefile]
indent_style = tab
